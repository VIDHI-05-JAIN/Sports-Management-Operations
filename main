import java.awt.*;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import javax.swing.*;

public class SportsManagementSystemGUI {
    private JFrame frame;
    private List<User> users;
    private List<Event> events;
    private List<Registration> registrations;

    public SportsManagementSystemGUI() {
        users = new ArrayList<>();
        events = new ArrayList<>();
        registrations = new ArrayList<>();
        initialize();
    }

    private void initialize() {
        // Main frame setup
        frame = new JFrame("Sports Management System");
        frame.setSize(400, 300);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout());

        // Buttons
        JButton btnUser = new JButton("User Interface");
        JButton btnAdmin = new JButton("Admin Interface");

        btnUser.addActionListener(e -> showUserInterface());
        btnAdmin.addActionListener(e -> showAdminInterface());

        JPanel panel = new JPanel();
        panel.add(btnUser);
        panel.add(btnAdmin);

        frame.add(panel, BorderLayout.CENTER);        frame.setVisible(true);

        // Adding sample events for testing
        events.add(new Event("Football Match", LocalDateTime.of(2024, 10, 15, 16, 0), "Stadium A"));
        events.add(new Event("Basketball Tournament", LocalDateTime.of(2024, 10, 20, 18, 30), "Arena B"));
    }

    // User Interface
    private void showUserInterface() {
        JFrame userFrame = new JFrame("User Interface");
        userFrame.setSize(400, 300);
        userFrame.setLayout(new GridLayout(4, 1));

        JButton btnRegister = new JButton("Register");
        JButton btnViewEvents = new JButton("View Events");
        JButton btnRegisterForEvent = new JButton("Register for Event");

        btnRegister.addActionListener(e -> showUserRegistration());
        btnViewEvents.addActionListener(e -> showEvents());
        btnRegisterForEvent.addActionListener(e -> showEventRegistration());

        userFrame.add(btnRegister);
        userFrame.add(btnViewEvents);
        userFrame.add(btnRegisterForEvent);

        userFrame.setVisible(true);
    }

    // Admin Interface
    private void showAdminInterface() {
        JFrame adminFrame = new JFrame("Admin Interface");
        adminFrame.setSize(400, 300);
        adminFrame.setLayout(new GridLayout(4, 1));

        JButton btnAddEvent = new JButton("Add Event");
        JButton btnViewRegistrations = new JButton("View Registrations");
        JButton btnViewEvents = new JButton("View Events");  // New button for viewing all events

        btnAddEvent.addActionListener(e -> showAddEvent());
        btnViewRegistrations.addActionListener(e -> showRegistrations());
        btnViewEvents.addActionListener(e -> showEvents());  // Action to display events for the admin

        adminFrame.add(btnAddEvent);
        adminFrame.add(btnViewRegistrations);
        adminFrame.add(btnViewEvents);  // Add button to the admin panel

        adminFrame.setVisible(true);
    }

    // User registration
    private void showUserRegistration() {
        JFrame registerFrame = new JFrame("User Registration");
        registerFrame.setSize(400, 300);
        registerFrame.setLayout(new GridLayout(4, 2));

        JLabel lblUsername = new JLabel("Username:");
        JTextField txtUsername = new JTextField();
        JLabel lblPassword = new JLabel("Password:");
        JPasswordField txtPassword = new JPasswordField();
        JLabel lblEmail = new JLabel("Email:");
        JTextField txtEmail = new JTextField();
        JButton btnSubmit = new JButton("Register");

        btnSubmit.addActionListener(e -> {
            String username = txtUsername.getText();
            String password = new String(txtPassword.getPassword());
            String email = txtEmail.getText();

            users.add(new User(username, password, email));
            JOptionPane.showMessageDialog(null, "User registered successfully!");
            registerFrame.dispose();
        });

        registerFrame.add(lblUsername);
        registerFrame.add(txtUsername);
        registerFrame.add(lblPassword);
        registerFrame.add(txtPassword);
        registerFrame.add(lblEmail);
        registerFrame.add(txtEmail);
        registerFrame.add(btnSubmit);

        registerFrame.setVisible(true);
    }

    // Display Events for both User and Admin
    private void showEvents() {
        JFrame eventsFrame = new JFrame("Available Events");
        eventsFrame.setSize(400, 300);

        StringBuilder eventDetails = new StringBuilder();
        for (Event event : events) {
            eventDetails.append("Event: ").append(event.getEventName())
                         .append(", Date: ").append(event.getEventDate())
                         .append(", Location: ").append(event.getLocation()).append("\n");
        }

        JTextArea textArea = new JTextArea(eventDetails.toString());
        textArea.setEditable(false);
        eventsFrame.add(new JScrollPane(textArea));

        eventsFrame.setVisible(true);
    }

    // Event registration for a user
    private void showEventRegistration() {
        JFrame registerEventFrame = new JFrame("Event Registration");
        registerEventFrame.setSize(400, 300);
        registerEventFrame.setLayout(new GridLayout(3, 2));

        JLabel lblUsername = new JLabel("Username:");
        JTextField txtUsername = new JTextField();
        JLabel lblEventName = new JLabel("Event Name:");
        JTextField txtEventName = new JTextField();
        JButton btnRegister = new JButton("Register for Event");

        btnRegister.addActionListener(actionEvent -> {  // Renamed 'e' to 'actionEvent'
            String username = txtUsername.getText();
            String eventName = txtEventName.getText();

            User user = users.stream().filter(u -> u.getUsername().equals(username)).findFirst().orElse(null);
            Event event = events.stream().filter(eventItem -> eventItem.getEventName().equals(eventName)).findFirst().orElse(null);  // Renamed 'e' to 'eventItem'

            if (user == null) {
                JOptionPane.showMessageDialog(null, "User not found.");
            } else if (event == null) {
                JOptionPane.showMessageDialog(null, "Event not found.");
            } else {
                registrations.add(new Registration(user, event));
                JOptionPane.showMessageDialog(null, "Registration successful for " + user.getUsername() + "!");
            }
        });

        registerEventFrame.add(lblUsername);
        registerEventFrame.add(txtUsername);
        registerEventFrame.add(lblEventName);
        registerEventFrame.add(txtEventName);
        registerEventFrame.add(btnRegister);

        registerEventFrame.setVisible(true);
    }

    // Add event by admin
    private void showAddEvent() {
        JFrame addEventFrame = new JFrame("Add Event");
        addEventFrame.setSize(400, 300);
        addEventFrame.setLayout(new GridLayout(4, 2));

        JLabel lblEventName = new JLabel("Event Name:");
        JTextField txtEventName = new JTextField();
        JLabel lblEventDate = new JLabel("Event Date (YYYY-MM-DD HH:MM):");
        JTextField txtEventDate = new JTextField();
        JLabel lblLocation = new JLabel("Location:");
        JTextField txtLocation = new JTextField();
        JButton btnAdd = new JButton("Add Event");

        btnAdd.addActionListener(e -> {
            String eventName = txtEventName.getText();
            LocalDateTime eventDate = LocalDateTime.parse(txtEventDate.getText().replace(" ", "T"));
            String location = txtLocation.getText();

            events.add(new Event(eventName, eventDate, location));
            JOptionPane.showMessageDialog(null, "Event added successfully!");
            addEventFrame.dispose();
        });

        addEventFrame.add(lblEventName);
        addEventFrame.add(txtEventName);
        addEventFrame.add(lblEventDate);
        addEventFrame.add(txtEventDate);
        addEventFrame.add(lblLocation);
        addEventFrame.add(txtLocation);
        addEventFrame.add(btnAdd);

        addEventFrame.setVisible(true);
    }

    // View registrations
    private void showRegistrations() {
        JFrame registrationFrame = new JFrame("View Registrations");
        registrationFrame.setSize(400, 300);

        StringBuilder regDetails = new StringBuilder();
        for (Registration registration : registrations) {
            regDetails.append("User: ").append(registration.getUser().getUsername())
                      .append(", Event: ").append(registration.getEvent().getEventName()).append("\n");
        }

        JTextArea textArea = new JTextArea(regDetails.toString());
        textArea.setEditable(false);
        registrationFrame.add(new JScrollPane(textArea));

        registrationFrame.setVisible(true);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new SportsManagementSystemGUI());
    }
}

